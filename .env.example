# ==============================================================================
# KONFIGURASI SUPABASE (Wajib untuk sinkronisasi online & Auth)
# ==============================================================================
# Cara menyiapkan:
# 1. Buka https://supabase.com/dashboard dan buat project baru.
# 2. Masuk ke menu SQL Editor -> New Query, lalu salin dan jalankan seluruh isi
#    file `supabase/migrations/0001_initial_schema.sql`.
# 3. Masuk ke Project Settings -> API.
# 4. Salin "Project URL" ke NEXT_PUBLIC_SUPABASE_URL di bawah ini.
# 5. Salin "anon" / "public" key ke NEXT_PUBLIC_SUPABASE_ANON_KEY di bawah ini.
# 6. PENTING: JANGAN PERNAH memasukkan `service_role` key ke file yang diekspos
#    ke klien atau dengan awalan NEXT_PUBLIC_!
# 7. Salin file ini menjadi `.env.local` untuk development lokal.
#    Catatan: Aplikasi ini offline-first! Tanpa env Supabase pun aplikasi tetap
#    bisa digunakan penuh secara lokal dengan IndexedDB di browser.

NEXT_PUBLIC_SUPABASE_URL=https://project-id-anda.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
